<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <colors>
        <color name="Background" rgba="#20242BFF"/>
        <color name="Panel" rgba="#2B3039FF"/>
        <color name="Text" rgba="#F2F4F8FF"/>
        <color name="Muted" rgba="#A9B0BCFF"/>
        <color name="Accent" rgba="#74B9FFFF"/>
        <color name="Frame" rgba="#11151AFF"/>
    </colors>
    <control-tags>
        <control-tag name="Bypass" tag="100"/>
        <control-tag name="Compression" tag="2000"/>
        <control-tag name="Output" tag="2001"/>
        <control-tag name="Mix" tag="2002"/>
    </control-tags>
    <template name="view" class="CViewContainer" origin="0, 0" size="440, 225" background-color="Background">
        <view class="CTextLabel" origin="20, 14" size="300, 30" title="LVS Compressor" font-color="Text" transparent="true" font-size="20"/>
        <view class="CTextLabel" origin="20, 43" size="350, 20" title="Airwindows ButterComp2 DSP" font-color="Muted" transparent="true" font-size="11"/>

        <view class="CKnob" origin="45, 82" size="70, 70" control-tag="Compression" back-color="Panel" frame-color="Frame" value-color="Accent" corona-color="Accent"/>
        <view class="CKnob" origin="185, 82" size="70, 70" control-tag="Output" back-color="Panel" frame-color="Frame" value-color="Accent" corona-color="Accent"/>
        <view class="CKnob" origin="325, 82" size="70, 70" control-tag="Mix" back-color="Panel" frame-color="Frame" value-color="Accent" corona-color="Accent"/>

        <view class="CTextLabel" origin="25, 158" size="110, 22" title="Compression" font-color="Text" transparent="true" text-alignment="center"/>
        <view class="CTextLabel" origin="180, 158" size="80, 22" title="Output" font-color="Text" transparent="true" text-alignment="center"/>
        <view class="CTextLabel" origin="320, 158" size="80, 22" title="Mix" font-color="Text" transparent="true" text-alignment="center"/>

        <view class="CCheckBox" origin="325, 194" size="95, 22" title="Bypass" control-tag="Bypass" font-color="Muted"/>
    </template>
</vstgui-ui-description>
